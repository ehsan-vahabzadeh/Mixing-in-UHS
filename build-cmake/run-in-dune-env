# setup with Dune-configured venv
if [ -f "/home/n71743ev/python/dumux_venv/bin/activate" ]; then
  source /home/n71743ev/python/dumux_venv/bin/activate

  # test if build directory matches installed dune python packages
  python -m dune checkbuilddirs Mixing-in-UHS /home/n71743ev/DUMUX/dumux/Mixing-in-UHS/build-cmake

# setup with some other active venv
# requires to install the correct dune python packages into this
# venv before using this script
elif [ -n "$VIRTUAL_ENV" ]; then
  # test if build directory matches installed dune python packages
  python -m dune checkbuilddirs Mixing-in-UHS /home/n71743ev/DUMUX/dumux/Mixing-in-UHS/build-cmake

# setup without venv and set-dune-pythonpath script available
elif [ -f "/home/n71743ev/DUMUX/dumux/Mixing-in-UHS/build-cmake/set-dune-pythonpath" ]; then
  source /home/n71743ev/DUMUX/dumux/Mixing-in-UHS/build-cmake/set-dune-pythonpath

else
  echo "Dune internal virtual environment not found:"
  echo "No activate script in /home/n71743ev/python/dumux_venv/bin"
  exit 77
fi

if [ $? -eq 0 ] ; then
  "$@"
else
  echo "Dune python package could not be found."
  exit 77
fi
